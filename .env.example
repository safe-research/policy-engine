# One of the following is required.
MNEMONIC=
PK=

# Required for deployment.
POLICIES_CONFIG_DELAY=

# Required for contract verification.
ETHERSCAN_API_KEY=

# Required for gas report.
HARDHAT_GAS_REPORTER_ENABLED=true

# Required for deployment (whether for Safe App [true] or production [false])
DEMO=false

# SafenetPolicy constructor arguments. All five must be set for the policy to be deployed; they
# identify the Safenet Consensus deployment and its genesis FROST group key.
SAFENET_CONSENSUS_CHAIN_ID=
SAFENET_CONSENSUS_ADDRESS=
SAFENET_INITIAL_EPOCH=
SAFENET_GROUP_KEY_X=
SAFENET_GROUP_KEY_Y=
